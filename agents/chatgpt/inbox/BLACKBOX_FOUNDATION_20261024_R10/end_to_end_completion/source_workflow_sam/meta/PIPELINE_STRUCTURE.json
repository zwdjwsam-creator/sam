      {
        "line": 70,
        "text": "def evaluate_lane_a_asof_gate("
      },
      {
        "line": 76,
        "text": "\"\"\"P0-A gate: cleaning_as_of only; SOURCE==CLEAN==CACHE required for PASS."
      },
      {
        "line": 78,
        "text": "AUTHORIZED: no asof/data_asof fallback for cleaning. Fail → STATUS=NO."
      },
      {
        "line": 86,
        "text": "\"SOURCE_ASOF\": None,"
      },
      {
        "line": 87,
        "text": "\"CLEAN_ASOF\": None,"
      },
      {
        "line": 88,
        "text": "\"CACHE_ASOF\": None,"
      },
      {
        "line": 90,
        "text": "\"STATUS\": \"NO\","
      },
      {
        "line": 112,
        "text": "if \"asof\" in clean and \"data_asof\" not in clean:"
      },
      {
        "line": 113,
        "text": "out[\"reason_code\"] = \"CLEANING_ONLY_HAS_asof\""
      },
      {
        "line": 114,
        "text": "elif \"data_asof\" in clean and \"asof\" not in clean:"
      },
      {
        "line": 115,
        "text": "out[\"reason_code\"] = \"CLEANING_ONLY_HAS_data_asof\""
      },
      {
        "line": 116,
        "text": "elif \"asof\" in clean or \"data_asof\" in clean:"
      },
      {
        "line": 119,
        "text": "out[\"reason_code\"] = \"CLEAN_ASOF_NULL\""
      },
      {
        "line": 122,
        "text": "source_asof = normalize_asof(scope.get(\"data_asof\"))"
      },
      {
        "line": 123,
        "text": "clean_asof = normalize_asof(clean.get(\"cleaning_as_of\"))"
      },
      {
        "line": 125,
        "text": "cache_asof = normalize_asof(cache.get(\"asof\"))"
      },
      {
        "line": 128,
        "text": "out[\"SOURCE_ASOF\"] = source_asof"
      },
      {
        "line": 129,
        "text": "out[\"CLEAN_ASOF\"] = clean_asof"
      },
      {
        "line": 130,
        "text": "out[\"CACHE_ASOF\"] = cache_asof"
      },
      {
        "line": 133,
        "text": "if source_asof is None:"
      },
      {
        "line": 136,
        "text": "if clean_asof is None:"
      },
      {
        "line": 137,
        "text": "out[\"reason_code\"] = \"CLEAN_ASOF_NULL\""
      },
      {
        "line": 139,
        "text": "if cache_asof is None:"
      },
      {
        "line": 143,
        "text": "if source_asof != clean_asof and source_asof != cache_asof and clean_asof != cache_asof:"
      },
      {
        "line": 147,
        "text": "if source_asof != clean_asof and source_asof == cache_asof:"
      },
      {
        "line": 150,
        "text": "if source_asof != cache_asof and source_asof == clean_asof:"
      },
      {
        "line": 153,
        "text": "if source_asof != clean_asof and clean_asof == cache_asof:"
      },
      {
        "line": 156,
        "text": "if source_asof != clean_asof:"
      },
      {
        "line": 159,
        "text": "if source_asof != cache_asof:"
      },
      {
        "line": 162,
        "text": "if clean_asof != cache_asof:"
      },
      {
        "line": 170,
        "text": "out[\"STATUS\"] = \"PASS\""
      },
      {
        "line": 192,
        "text": "return subprocess.run(cmd, cwd=str(ROOT)).returncode"
      },
      {
