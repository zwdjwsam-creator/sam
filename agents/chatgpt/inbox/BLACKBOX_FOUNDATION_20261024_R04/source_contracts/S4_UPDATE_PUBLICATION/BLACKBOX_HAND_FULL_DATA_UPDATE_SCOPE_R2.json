      "ETF_minute_5m_1m_30m_60m_raw_none",
      "A_share_minute_5m_replacement",
      "A_share_minute_1m_replacement",
      "A_share_minute_30m_60m",
      "billboard_longhubang",
      "p5_events_aux",
      "hk_connector_aux",
      "etf_fund_aux",
      "sw_l1_membership_pit_densify",
