  "authorized_at_user_utterance": "统一规则，不要乱，数据更新就是全数据增量下载，加清洗对齐防止穿越，包含因子、财务报表、龙虎榜、指数数据等；盘点全部数据统一口径，让HAND放行",
  "supersedes": [
    "BLACKBOX_HAND_FULL_DATA_UPDATE_SCOPE_R1",
    "blackbox_data_update_morning.mdc_incremental_only_semantics"
  ],
  "trigger_phrases": [
    "数据更新",
    "更新数据",
    "全数据更新",
    "黑盒全量更新",
    "更新全数据",
    "数据增量更新"
  ],
  "definition_one_line": "数据更新 = 全数据增量/缺口下载（含指数分钟732、SW L1/L2/L3、全量因子值库（可取尽取）、财务指标、资金流/异常/锁仓/申购、JQ260 因子值库（权限重探通过后）） + 正式清洗对齐 + 防穿越 + Cache 切片 CURRENT + 刷新总表；不含 fq 前/后复权整库与 QMT 实时。",
  "pipeline": [
    "preflight_HAND_read",
    "scan_gaps_vs_CURRENT_asof",
    "incremental_download_all_REQUIRED_ACTIVE_domains",
    "formal_cleaning_candidate_build_no_CURRENT_switch",
    "index_minute_align_or_reuse_CURRENT_INDEX_MINUTE_ALIGN",
    "anti_leakage_PIT_available_from_ts_checks",
    "inventory_top_refresh_mdc",
    "cache_compiler_daily_incremental",
    "sw_l1_l2_l3_membership_densify_for_new_asof_days",
    "sw_l1_l2_l3_pit_align_seal_CURRENT",
    "cache_sw_l1_l2_l3_membership_product_integrate",
    "atomic_publish_CLEANING_AND_CACHE_CURRENT"
  ],
  "mode": "INCREMENTAL_FROM_CURRENT_ASOF",
  "asof_policy": "trade_date / finance_asof / cleaning_as_of / index_minute_cutoff 同批对齐并写入 CURRENT",
  "means": {
    "download_REQUIRED_ACTIVE": [
      "calendar_cn_exchange",
      "industry_concept_meta",
      "adjust_factor",
